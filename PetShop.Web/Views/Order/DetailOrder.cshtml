@using PetShop.Domain.Models.Users
@model DetailUserViewModel
@{
    
         var order = TempData["ShowOrder"] as List<ShowOrderViewModel>;
    
  
}
<section class="container-fluid bkg p-0">
    <div class="row">
        <div class="col-lg-12 p-0 mb-3">
            <div class="bg-package d-flex align-items-center justify-content-center">
                <div class="breadcrumb radius15">
                    <ul class="d-flex align-items-center">
                        <li><a href="/">خانه</a></li>
                        <li><a href="/order/ShowOrderDetails"> /سبد خرید</a></li>
                        <svg width="12" height="11" viewBox="0 0 12 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10.8019 6.17453H2.56566C2.00285 6.17453 1.53613 5.70782 1.53613 5.14501C1.53613 4.5822 2.00285 4.11548 2.56566 4.11548H10.8019C11.3647 4.11548 11.8314 4.5822 11.8314 5.14501C11.8314 5.70782 11.3647 6.17453 10.8019 6.17453Z" fill="#292D32"></path>
                            <path d="M5.31096 10.2918C5.05014 10.2918 4.78933 10.1958 4.58342 9.98985L0.465311 5.87174C0.067227 5.47366 0.067227 4.81476 0.465311 4.41667L4.58342 0.298563C4.98151 -0.099521 5.64041 -0.099521 6.03849 0.298563C6.43657 0.696647 6.43657 1.35554 6.03849 1.75363L2.64791 5.14421L6.03849 8.53479C6.43657 8.93287 6.43657 9.59177 6.03849 9.98985C5.83258 10.1958 5.57177 10.2918 5.31096 10.2918Z" fill="#292D32"></path>
                        </svg>
                        <li><a href="#" class="current">جزئیات پرداخت</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model == null)
{
    <div class="row d-block text-center m-3">
        <p class="alert alert-danger d-block text-center">آیتمی برای نمایش وجود ندارد!</p>
    </div>
}
else
{

    <section class="text-lg-right text-center my-4">

        <div class="container">
            <div class="card p-5 p-checkout">
                <div class="row">

                    <form asp asp-controller="Order" asp-action="OrderFinally" class="contact-form d-flex justify-content-between form-checkout">
                        <div asp-validation-summary="ModelOnly"></div>
                        <div class="col-lg-8">
                            <p class="mb-3">جزئیات صورتحساب:</p>

                            <div class="form-row">

                                <div class="form-group col-md-6">
                                    <label asp-for="Name">نام:</label>
                                    <input asp-for="Name" type="text" class="form-control mb-1">
                                    <span asp-validation-for="Name"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Family">نام خانوادگی:</label>
                                    <input asp-for="Family" type="text" class="form-control mb-1"> <span asp-validation-for="Family"></span>
                                </div>


                                <div class="form-group col-md-6">
                                    <label asp-for="State">
                                        استان:
                                    </label>
                                    <input asp-for="State" type="text" class="form-control mb-1">
                                    <span asp-validation-for="State"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="City">شهر:</label>
                                    <input asp-for="City" type="text" class="form-control mb-1">
                                    <span asp-validation-for="City"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Street">
                                        آدرس خیابان:
                                    </label>
                                    <input asp-for="Street" type="text" class="form-control mb-1">
                                    <span asp-validation-for="Street"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="ApartmentName">آپارتمان، مجتمع، واحد و... (اختیاری):</label>
                                    <input asp-for="ApartmentName" type="text" class="form-control mb-1">
                                    <span asp-validation-for="ApartmentName"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Zip_Code">کدپستی:</label>
                                    <input asp-for="Zip_Code" type="text" class="form-control mb-1">
                                    <span asp-validation-for="Zip_Code"></span>
                                </div>
                              

                                <div class="form-group col-md-6">
                                    <label asp-for="PhoneNumber">تلفن:</label>
                                    <input asp-for="PhoneNumber" type="text" class="form-control mb-1">
                                    <span asp-validation-for="PhoneNumber"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Email">ایمیل:</label>
                                    <input asp-for="Email" type="text" class="form-control mb-1">
                                    <span asp-validation-for="Email"></span>
                                </div>
                                <input type="hidden" asp-for=UserId />


                            </div>
                        </div>

                        <div class="col-lg-4">
                            <p class="mb-3">سفارش شما: </p>
                            <div class="bg-title-sidebar radius20 side-category p-4 mb-2">

                                <ul class="list-unstyled">

                                    <li>
                                        محصول
                                        <div class="d-flex align-items-center justify-content-center">
                                            جمع جزء
                                        </div>
                                    </li>
                                    @if (order != null)
                                    {
                                        @foreach (var item in order)
                                        {
                                            <li>
                                                @item.ProductName
                                                <div class="d-flex align-items-center justify-content-center">
                                                    @item.Price.Tomony()   تومان
                                                </div>
                                            </li>
                                        }
                                        <hr>

                                        <li>
                                            جمع جزء:
                                            <div class="d-flex align-items-center justify-content-center">
                                                @order.Sum(o => o.Price).Tomony()   تومان
                                            </div>
                                        </li>
                                        <li>
                                            مجموع:
                                            <div class="d-flex align-items-center justify-content-center">
                                                @order.Sum(o => o.Price).Tomony()   تومان
                                            </div>
                                        </li>

                                        <button type="submit" class="btn btn-lightorng btn-checkout">ثبت سفارش و پرداخت</button>
                                    }
                                    else
                                    {
                                        <div class="row d-block text-center m-3">
                                            <p class="alert alert-danger d-block text-center">آیتمی برای نمایش وجود ندارد!</p>
                                        </div>
                                        <button class="btn btn-lightorng btn-checkout"> <a href="/order/ShowOrderDetails" style="color:red;">رفتن به سبد خرید</a></button>
                                    }




                                

                                    @* <li> *@
                                    @*     حمل و نقل: *@
                                    @*     <div class="d-flex align-items-center justify-content-center"> *@
                                    @*         رایگان *@
                                    @*     </div> *@
                                    @* </li> *@

                                    @* <li> *@
                                    @*     مجموع: *@
                                    @*     <div class="d-flex align-items-center justify-content-center"> *@
                                    @*         @order.Sum(o => o.Price).Tomony()   تومان *@
                                    @*     </div> *@
                                    @* </li> *@

                                </ul>

                            </div>




                        </div>

                    </form>

                </div>

            </div>
        </div>

    </section>
}

@section Footer{
    <partial name="_Footer_Partial" />
}

@section Script{
    <partial name="_ValidationScriptsPartial" />
}