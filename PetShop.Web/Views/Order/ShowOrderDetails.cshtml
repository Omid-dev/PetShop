@using PetShop.Domain.Models.Orders
@model Order
@if (Model.OrderDetails==null||Model==null)
{

    <div class="row d-block text-center m-3">
        <p class="alert alert-primary d-block text-center">سبد خرید شما خالی است!</p>
    </div>
}
else
{


    int sum = Model.OrderDetails.Sum(o => o.Price * o.Count);

    <section class="container-fluid bkg p-0">
        <div class="row">
            <div class="col-lg-12 p-0 mb-3">
                <div class="bg-package d-flex align-items-center justify-content-center">
                    <div class="breadcrumb radius15">
                        <ul class="">
                            <li><a href="/">خانه / </a></li>
                            <li><a href="#" class="current">سبد خرید</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <section class="container mb-4">
        <div class="row">

            <div class="col-xl-4 order-xl-1 pt-3 order-1 mb-3">


                <div class="card side-category p-4 mb-3">
                    <ul class="list-unstyled">

                        <li class="p-3 bg-title-sidebar radius15">
                            قیمت کالا ها (@Model.OrderDetails.Sum(od => od.Count) عدد):

                            <div class="d-flex align-items-center justify-content-center">
                                @sum.Tomony() تومان
                            </div>

                        </li>


                    </ul>
                    <ol>
                        <li>
                            هزینه این سفارش هنوز پرداخـت نشده و در صورت اتمــام موجــودی
                            کالا ها از سبد خرید شما حدف می شوند.
                        </li>
                    </ol>
                    @if(Model.OrderDetails.Any()){
                        <a class="a-button radius55 py-3 px-4 text-center mt-3" asp-action="DetailOrder" asp asp-controller="Order">
                            <span class="ml-2">ثبت سفارش</span>
                        </a>
                    }else{
                        <div class="text-center col-md-12">
                            <p class="alert alert-danger d-block text-center col-md-12">کالائی انتخاب نشده است!!</p>
                        </div>

                    }
                </div>

            </div>

            <div class="col-xl-8 order-xl-0 order-0 mb-3">

                <div class="card m-3 p-4">

                    @foreach (var orderDetail in Model.OrderDetails)
                    {
                        <div class="item">

                            <div class="">



                                <div class="d-flex align-items-center justify-content-between mb-cart cart-res " id="order@(orderDetail.ProdcutId)">
                                    <div class="col-lg-3">
                                        <img src="/ProductImages/@orderDetail.Product.ImageName" style="max-width:100px;max-height:100px;" alt="">
                                    </div>
                                    <div class="col-lg-3"> @orderDetail.Product.Name </div>
                                    <div class="col-lg-3">@orderDetail.Price.Tomony() تومان</div>
                                    <div class="col-lg-3">
                                        <div class="input-group d-flex align-items-center justify-content-center cart-increment radius20">

                                            <span class="input-group-btn">
                                                <button type="button" class="quantity-right-plus btn p-3" id="increes" onclick="add(@orderDetail.ProdcutId)" data-type="plus" data-field="">
                                                    <svg width="15" height="16" viewBox="0 0 15 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M7.41602 1.71582V13.8158" stroke="#FFAA00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <path d="M13.599 7.76782H1.25195" stroke="#FFAA00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                    </svg>
                                                </button>
                                            </span>


                                            <input type="text" id="quantity@(orderDetail.ProdcutId)" name="quantity" class="input-cart form-control input-number" value="@orderDetail.Count" min="1" max="100" style="font-size:10px">




                                            <span class="input-group-btn">
                                                <button type="button" class="quantity-left-minus btn p-3" data-type="minus" data-field="" onclick="min(@orderDetail.ProdcutId)">
                                                    <svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M13.7663 7.31201C13.7663 7.31201 13.3343 12.675 13.0833 14.934C13.0768 15.172 13.0227 15.4063 12.9242 15.623C12.8257 15.8398 12.6847 16.0346 12.5097 16.1959C12.3346 16.3573 12.129 16.4819 11.905 16.5625C11.6809 16.6431 11.443 16.6779 11.2053 16.665C9.12829 16.702 7.04829 16.705 4.97129 16.665C4.73834 16.6729 4.50615 16.6345 4.28815 16.552C4.07014 16.4696 3.87065 16.3447 3.70121 16.1847C3.53177 16.0246 3.39575 15.8326 3.30101 15.6196C3.20627 15.4066 3.15471 15.177 3.14929 14.944C2.89729 12.665 2.46729 7.31701 2.46729 7.31701" stroke="#FFAA00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <path d="M14.8692 4.74121H1.36621" stroke="#FFAA00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <path d="M12.2663 4.74211C11.9632 4.74202 11.6694 4.63698 11.435 4.44484C11.2006 4.2527 11.0399 3.98531 10.9803 3.68811L10.7873 2.72011C10.7293 2.50318 10.6014 2.31147 10.4232 2.17476C10.2451 2.03805 10.0268 1.964 9.80229 1.96411H6.43128C6.20675 1.964 5.98846 2.03805 5.81034 2.17476C5.63222 2.31147 5.50424 2.50318 5.44629 2.72011L5.25129 3.68711C5.19195 3.98416 5.03166 4.25152 4.79762 4.44382C4.56357 4.63612 4.2702 4.74152 3.96729 4.74211" stroke="#FFAA00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                    </svg>

                                                </button>
                                            </span>

                                        </div>
                                    </div>

                                </div>


                            </div>

                        </div>
                    }
                </div>

            </div>

        </div>

    </section>
}


@section Footer {
    <partial name="_Footer_Partial" />
}
@section Script {
    <script>

        async function min(id)
         {

                  var idtxt=`#quantity${id}`;
                  var eltxt =document.getElementById(idtxt);
                  var eltxt=$(idtxt).val();



                if(eltxt>1)
                {
                    await $.get("/Order/ReduceCount?id="+id,function()
                    {

                     elQuentity.value=elQuentity.value-1;

                     location.reload(true);
                    })
                }
                else{

                      var elIdOrder=`#order${id}`;
                      var elOrder =document.getElementById(elIdOrder);
                      await $.get("/Order/DeleteOrder?id="+id,function()
                    {
                       elOrder.remove();
                       location.reload(true);
                    })

                }

                location.reload(true);

         }

        async function add(id){

        await $.get("/Order/AddCount?id="+id,function(){
             var elIdQuentity=`#quantity${id}`;
             var quentity =document.getElementById(elIdQuentity);
             quentity.value=quentity.value+1;
             alert(quentity.value);

         });

            location.reload(true);

         }


    </script>
}