

<div class="card-body mb-3 text-center">
    <a asp-action="Deteail" asp-controller="Product" asp-route-id="@Model.Id">
        <img style="width:223px;height:223px;max-width:223px; max-height:223px" class="img-fluid" src="/ProductImages/@Model.ImageName">
    </a>
    <div>
        <h5 class="my-2 YekanBakhFaNum-SemiBold"><a class="card-pro">@Model.Name</a></h5>
        <span class="color-orange YekanBakhFaNum-Bold fa18">@Convert.ToInt32(Model.Price).ToString("N0")</span>
        <span class="color-orange YekanBakhFaNum-Regular fa14">تومان</span>
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex">
                <div class="add-to-cart hoverable outlined">
                    <svg width="21" height="22" viewBox="0 0 21 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 21.25C15.9665 21.25 16.75 20.4665 16.75 19.5C16.75 18.5335 15.9665 17.75 15 17.75C14.0335 17.75 13.25 18.5335 13.25 19.5C13.25 20.4665 14.0335 21.25 15 21.25Z" fill="#FFAA00" />
                        <path d="M7 21.25C7.9665 21.25 8.75 20.4665 8.75 19.5C8.75 18.5335 7.9665 17.75 7 17.75C6.0335 17.75 5.25 18.5335 5.25 19.5C5.25 20.4665 6.0335 21.25 7 21.25Z" fill="#FFAA00" />
                        <path d="M3.59 2.69L3.39 5.14C3.35 5.61 3.72 6 4.19 6H19.5C19.92 6 20.27 5.68 20.3 5.26C20.43 3.49 19.08 2.05 17.31 2.05H5.02C4.92 1.61 4.72 1.19 4.41 0.84C3.91 0.31 3.21 0 2.49 0H0.75C0.34 0 0 0.34 0 0.75C0 1.16 0.34 1.5 0.75 1.5H2.49C2.8 1.5 3.09 1.63 3.3 1.85C3.51 2.08 3.61 2.38 3.59 2.69Z" fill="#FFAA00" />
                        <path d="M19.2601 7.5H3.92005C3.50005 7.5 3.16005 7.82 3.12005 8.23L2.76005 12.58C2.62005 14.29 3.96005 15.75 5.67005 15.75H16.7901C18.2901 15.75 19.6101 14.52 19.7201 13.02L20.0501 8.35C20.0901 7.89 19.7301 7.5 19.2601 7.5Z" fill="#FFAA00" />
                    </svg>

                    <span class="text-center"><a onclick="GoOrder(@Model.Id)">افزودن به سبد خرید</a></span>
                </div>

            </div>

        </div>



    </div>
</div>
@{
    if (User.Identity.IsAuthenticated)
    {
        <input type="hidden" id="login" value="login" />
    }
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>


    var login=$("#login").val();
       function GoOrder(id)
       {
           if(login)
           {
                        Swal.fire({
                        icon: 'success',
                        title: 'عملیات موفقیت‌آمیز',
                        text: 'به سبد خرید اضافه شد',
                        showCancelButton: true,
                        confirmButtonText: 'سبد خرید',
                        confirmButtonColor: '#3085d6',
                        cancelButtonText: 'بعدا',
                        cancelButtonColor: '#d33',
                        width: '25%',
                        padding: '.2em',
                         customClass:
                        {
                         popup: 'small-alert',
                         cancelButton: 'btn-alert1 btn-danger-alert1',
                         confirmButton: 'btn-alert1 btn-success-alert1',
                         }
                       }).then((result)=>
                       {
                       if (result.isConfirmed)
                       {
                      window.location.href="/Order/AddOrder/"+id;
                       }
                  });

              }
              else{

                     Swal.fire({
                         icon: 'warning',
                         title: 'هشدار',
                         text: 'برای ثبت سفارش باید وارد سایت شوید',
                         showCancelButton: true,
                         confirmButtonText: 'ورود به سایت',
                         cancelButtonText: 'بعدا',
                         confirmButtonColor: '#3085d6',
                         cancelButtonColor: '#d33',
                         background: '#fefefe',
                         width: '25%',
                         padding: '.2em',
                         customClass:
                         {
                         popup: 'small-alert',
                         cancelButton: 'btn-alert1 btn-danger-alert1',
                         confirmButton: 'btn-alert1 btn-success-alert1',
                         }
                        }).then((result)=>
                        {
                        if (result.isConfirmed)
                        {
                       window.location.href="/Login";
                        }
                       });
                     }
                  }
</script>
<link href="~/css/site.css" rel="stylesheet" />