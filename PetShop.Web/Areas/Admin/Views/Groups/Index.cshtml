@model IEnumerable<GroupViewModel>

@{
    ViewData["Title"] = "لیست گروه ها";
}

<h1>گروه ها</h1>

<p>
    <a class="btn btn-success btn-sm" asp-action="Create">افزودن گروه جدید</a>
</p>
<table class="table table-striped ">
    <thead>
        <tr>
            <th>
                توسط
            </th>
            <th>
                عنوان
            </th>
            <th>
               توضیحات
            </th>
            <th>
                تاریخ ایجاد
            </th>
            <th>
                تاریخ ویرایش
            </th>
            <th>
                آیا حذف شده است؟
            </th>
            <th>
                نمایش داخل صفحه اصلی 
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr class="@(item.IsDeleted.ToString().ToLower()=="true"?"danger":"success")"style="border:1px solid white">
            <td>
                @Html.DisplayFor(modelItem => item.NameOwner)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @item.CreateDate.Toshamsi()
            </td>
            <td>
               @item.ModifiedDate?.Toshamsi()
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsDeleted)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ShowHomeSite)
                </td>
            <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a> |
                    <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id">جزئیات</a> |
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">حذف</a>
            </td>
        </tr>
}
    </tbody>
</table>
