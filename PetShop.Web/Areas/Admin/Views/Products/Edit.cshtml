@model PetShop.Domain.Models.Products.Product

@{
    ViewData["Title"] = "ویرایش";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Desctiption" class="control-label"></label>
                <input asp-for="Desctiption" class="form-control" />
                <span asp-validation-for="Desctiption" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Text" class="control-label"></label>
                <textarea asp-for="Text" name="Text" class="form-control"></textarea>
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GroupId" class="control-label"></label>
                <select asp-for="GroupId" class="form-control" asp-items="ViewBag.GroupId"></select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserIdOwner" class="control-label"></label>
                <select asp-for="UserIdOwner" class="form-control" asp-items="ViewBag.UserIdOwner"></select>
                <span asp-validation-for="UserIdOwner" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label  class="control-label">تغییر تصویر</label>
                <input name="imgUpload" type="file" class="form-control" />
                <img style="width:223px;height:223px;max-width:223px; max-height:223px" src="/ProductImages/@Model.ImageName" />
                @* <span asp-validation-for="ImageName" class="text-danger"></span> *@
            </div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageName" />

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsDeleted" /> @Html.DisplayNameFor(model => model.IsDeleted)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <script>
        CKEDITOR.replace( 'Text' );
    </script>



    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
