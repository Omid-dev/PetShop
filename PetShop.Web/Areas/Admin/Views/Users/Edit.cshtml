@model PetShop.Domain.Models.Users.User

@{
    ViewData["Title"] = "ویرایش کاربر";
}

<h1>ویرایش</h1>


<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Family" class="control-label"></label>
                <input asp-for="Family" class="form-control" />
                <span asp-validation-for="Family" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group hidden" id="inputchange">
                <label asp-for="Password" class="control-label">پسورد جدید </label>
                <input asp-for="Password" class="form-control" value="/" id="inp"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>


            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsAdmin" /> @Html.DisplayNameFor(model => model.IsAdmin)
                </label>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsDeleted" /> @Html.DisplayNameFor(model => model.IsDeleted)
                </label>
            </div>
            <div class="form-group row" >
                <input type="submit" value="ویرایش" class="btn btn-primary" />
            </div>
        </form>

    
    </div>
</div>


<div class="row justify-content-around">
    <a asp-action="Index" class="btn  btn-danger">بازگشت</a>
    <button class="btn btn-sm btn-dark" id="changePassword">تغییر پسورد</button>
</div>

@section Scripts {
    <script>


                var btn = document.getElementById("changePassword");
         btn.addEventListener("click",function(){
             var inp= document.getElementById("inputchange");
             // document.getElementById("inp").setAttribute("value","");
             document.getElementById("inp").value="";
                
             inp.classList.toggle("hidden");
         })


        // function omid()
        // {

        //       var inp= document.getElementById("inputchange");
        //      inp.classList.toggle("hidden");
        //     alert(inp);
        // };
 
         // $("#changePassword").document.getElementById("inputchange").classList.remove("hidden");

         // $(document).ready(function () { $("#changePassword").click(function () { $("#inputchange").show(); }); });

    </script>




    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
